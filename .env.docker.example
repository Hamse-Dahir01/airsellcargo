# Copy to .env.docker and replace every example value. Do not commit .env.docker.
POSTGRES_DB=airsellcargo
POSTGRES_USER=airsell
POSTGRES_PASSWORD=use-a-long-url-safe-random-password
DATABASE_URL=postgres://airsell:use-a-long-url-safe-random-password@db:5432/airsellcargo
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
PORT=3000
TRUST_PROXY=0
